# --- Secrets: NEVER commit real settings. Commit only the *.example templates. ---
.env
.env.*
!.env.example
apps/web-app/.env
apps/web-app/.env.*
!apps/web-app/.env.local.example

# --- Dependencies and build output ---
node_modules/
dist/
coverage/
.next/
out/
.mastra/
*.tsbuildinfo

# --- Generated test output (the accepted baseline.json IS committed) ---
tests/evaluation/results/

# --- Local data, backups, logs, OS/editor files ---
*.sql
*.dump
*.log
npm-debug.log*
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.dcm
